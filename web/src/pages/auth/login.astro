---
import Layout from '../../layouts/Layout.astro';
import { apiUrl } from '../../lib/api.js';

const nextPath = Astro.url.searchParams.get('next') || '/';
const errorCode = Astro.url.searchParams.get('error');
const configRes = await fetch(apiUrl('/api/config'));
const config = configRes.ok ? await configRes.json() : {};
const oidcEnabled = config.oidc_enabled ?? false;
const oidcProviderName = config.oidc_provider_name || 'SSO';

const errorMessages: Record<string, string> = {
  oauth_pending: 'Your account is pending approval. The site owner will activate your access shortly.',
  oauth_exists: 'An account with this email already exists. Sign in with your password or contact the site owner.',
  oauth_no_email: 'Sign-in failed because your identity provider did not return an email address.',
  oauth_failed: 'Sign-in with SSO failed. Please try again or use email and password.',
};
const errorMessage = errorCode ? errorMessages[errorCode] || errorMessages.oauth_failed : null;
const safeNext = nextPath.startsWith('/') && !nextPath.startsWith('//') && nextPath[1] !== '\\' ? nextPath : '/';
const ssoStartUrl = `/api/auth/oidc/start?next=${encodeURIComponent(safeNext)}`;
---

<Layout title="Login">
  <div class="frame min-h-screen flex items-center justify-center py-8">
    <div class="w-full max-w-sm bg-surface p-8 rounded-lg border border-line shadow-1">
      <div class="mb-8 text-center">
        <h1 class="display text-3xl mb-2">Welcome Back</h1>
        <p class="text-sm text-muted">Sign in to your account</p>
      </div>

      {errorMessage && (
        <div class="alert alert-danger mb-4">{errorMessage}</div>
      )}

      <div id="error-banner" class="alert alert-danger hidden mb-4"></div>

      {oidcEnabled && (
        <>
          <a href={ssoStartUrl} class="btn w-full justify-center mb-4">
            Sign in with {oidcProviderName}
          </a>
          <div class="relative mb-6">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-line"></div>
            </div>
            <div class="relative flex justify-center text-xs uppercase">
              <span class="bg-surface px-2 text-muted">or continue with email</span>
            </div>
          </div>
        </>
      )}

      <form class="flex flex-col gap-4" onsubmit="event.preventDefault(); login(this);">
        <div class="flex flex-col gap-1">
          <label class="label" for="email">Email address</label>
          <input type="email" id="email" name="email" class="form-input" required>
        </div>

        <div class="flex flex-col gap-1">
          <label class="label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-input" required>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary justify-center mt-4">Sign In</button>
      </form>

      <div class="mt-6 text-center">
        <a href="/auth/register" class="text-sm text-muted hover:text-ember transition-colors">Create an account</a>
        <span class="text-sm text-muted px-2">·</span>
        <a href="/auth/forgot-password" class="text-sm text-muted hover:text-ember transition-colors">Forgot password?</a>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // Mirrors _safe_next_path on the API. startsWith('/') alone is not enough:
  // '//evil.com' is protocol-relative, and browsers normalise '/\' to '//',
  // so both would navigate off-origin.
  function safeNextPath(raw) {
    if (!raw || raw[0] !== '/') return '/';
    if (raw[1] === '/' || raw[1] === '\\') return '/';
    return raw;
  }

  const nextPath = safeNextPath(new URLSearchParams(window.location.search).get('next'));

  async function login(form) {
    const btn = document.getElementById('submit-btn');
    const banner = document.getElementById('error-banner');
    banner.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Signing in…';

    const formData = new URLSearchParams();
    formData.append('username', form.email.value);
    formData.append('password', form.password.value);

    try {
      const res = await fetch('/api/auth/jwt/login', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData.toString(),
      });

      if (res.ok) {
        window.location.href = nextPath;
      } else {
        const data = await res.json().catch(() => ({}));
        showError(data.detail || 'Invalid email or password.');
      }
    } catch (err) {
      showError('Could not reach the server. Try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Sign In';
    }

    function showError(msg) {
      banner.textContent = msg;
      banner.classList.remove('hidden');
    }
  }
</script>
