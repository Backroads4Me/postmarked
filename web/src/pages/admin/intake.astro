---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Media Intake">
  <div id="uppy-dashboard" class="mb-12"></div>

  <script type="module" hoist>
    // Bundled rather than imported from a CDN at runtime: this page carries an
    // admin session, a bare module specifier cannot take an integrity hash, and
    // a blocked or unreachable CDN left an empty panel with no explanation.
    import Uppy from '@uppy/core';
    import Dashboard from '@uppy/dashboard';
    import Tus from '@uppy/tus';
    import '@uppy/core/dist/style.min.css';
    import '@uppy/dashboard/dist/style.min.css';

    const uppy = new Uppy({
      restrictions: {
        maxNumberOfFiles: 50
      }
    })
    .use(Dashboard, {
      inline: true,
      target: '#uppy-dashboard',
      theme: 'dark'
    })
    .use(Tus, {
      endpoint: '/api/admin/media/tus',
      limit: 3,
      retryDelays: [0, 1000, 3000, 5000],
      chunkSize: 5 * 1024 * 1024,
    });

    uppy.on('complete', (result) => {
      const succeeded = result.successful.length;
      const failed = result.failed.length;
      if (failed > 0) {
        alert(`${succeeded} upload${succeeded === 1 ? '' : 's'} completed; ${failed} failed. Review the failed files and retry.`);
      } else if (succeeded > 0) {
        alert("Upload finished. Assets pushed to processing queue!");
        window.location.href = '/admin/media';
      }
    });
  </script>
</AdminLayout>
