---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { apiUrl } from '../../../lib/api.js';
import { formatDate as fmtDate } from '../../../lib/dates.js';

let posts = [];
let truncated = false;
// The endpoint defaults to 100 rows and this page has no pagination, so ask
// for a large page and say so plainly if it still fills up, rather than
// dropping older posts with no indication.
const POST_PAGE_LIMIT = 500;
try {
  const res = await fetch(apiUrl(`/api/admin/posts?limit=${POST_PAGE_LIMIT}`), {
    headers: { 'Cookie': Astro.request.headers.get('cookie') || '' }
  });
  if (res.ok) posts = await res.json();
  truncated = posts.length >= POST_PAGE_LIMIT;
} catch (e) {
  console.error(e);
}

function formatPostDate(dateStr) {
  return fmtDate(dateStr, { month: 'short', day: 'numeric', year: 'numeric' });
}

function statusBadge(status) {
  if (status === 'draft') return 'badge-draft';
  if (status === 'published') return 'badge-published';
  if (status === 'unpublished') return 'badge-unpublished';
  if (status === 'archived') return 'badge-private';
  return 'badge-draft';
}
---

<AdminLayout title="Posts">
  <div class="mb-8 flex justify-end">
    <a href="/admin/posts/new" class="btn btn-sm">New Post</a>
  </div>

  {truncated && (
    <div class="alert mb-6">
      Showing the {POST_PAGE_LIMIT} most recent posts. Older posts are not listed here,
      but remain published and can still be opened directly by URL.
    </div>
  )}

  {posts.length > 0 ? (
    <div class="grid gap-4">
      {posts.map(post => (
        <div class="card-flat">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-lg" aria-hidden="true">✏️</span>
              <span class={`badge badge-sm ${statusBadge(post.status)}`}>
                {post.status}
              </span>
              <span class={`badge badge-sm ${post.visibility === 'public' ? 'badge-public' : 'badge-private'}`}>
                {post.visibility}
              </span>
            </div>
            <div class="flex items-center gap-3 self-center">
              <span class="text-paper text-base font-medium leading-none">{formatPostDate(post.posted_at)}</span>
              <a href={`/admin/posts/${post.id}`} class="btn btn-ghost btn-sm">Edit</a>
            </div>
          </div>
          <h3 class="text-base font-medium" style="color: var(--paper);">{post.title}</h3>
          {post.body && <p class="text-sm text-muted mt-1 line-clamp-2">{post.body}</p>}
          {post.stop_title && (
            <span class="coord mt-2 block">📍 {post.stop_title}</span>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <div class="icon">✏️</div>
      <h3>No posts yet</h3>
      <p>Create a quick post to share what you're up to.</p>
    </div>
  )}
</AdminLayout>
